# Onde o proxy de dev do Vite manda /api. shema-api local sobe em :8000.
VITE_API_PROXY_TARGET=http://localhost:8000

# Prefixo que o cliente Axios usa. Em dev o proxy acima atende /api; em produção
# o entrypoint do contêiner injeta a URL do backend.
VITE_API_BASE_URL=/api

# Força a origem dos dados de todos os namespaces: "fixtures" (onda 1, sem backend
# nenhum, inclusive a sessão) ou "api". Vazio usa a tabela de src/services/api/source.ts,
# que diz qual namespace cada INT já ligou.
VITE_DATA_SOURCE=
